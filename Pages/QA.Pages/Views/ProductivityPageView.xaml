                            <TextBlock Grid.Row="0" Text="Tossing By Nozzle" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding NozzleHistogramTossingSeriesCollection1}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsNozzleGND}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="抛料(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Tossing By Day" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding WeekHistogramTossingSeriesCollection1}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsWeekGND}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="抛料(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem
            Width="200"
            FontSize="18"
            Header="复检"
            Selector.IsSelected="True">
            <Grid Background="#19447A">
                <!--旧的颜色 #20406A-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="StartTime" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding RecheckNGStartData}" />
                    <Label
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="EndTime" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding RecheckNGEndData}" />
                    <Label
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Nozzle" />
                    <ComboBox Grid.Column="5">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                    <Button
                        Grid.Column="6"
                        Height="auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        cal:Message.Attach="[Event Click]=[Action QueryRecheckNGCount]"
                        Content="Query"
                        FontSize="16" />
                    <Button
                        Grid.Column="7"
                        Height="auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        cal:Message.Attach="[Event Click] = [Action OpenRecheckData]"
                        Content="Save"
                        FontSize="16" />
                    <Button
                        Grid.Column="8"
                        Height="auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        cal:Message.Attach="[Event Click] = [Action ChangeUPHTossing]"
                        Content="{Binding UPHTossingButtonStr}"
                        FontSize="16" />
                    <Button
                        Grid.Column="9"
                        Height="auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        cal:Message.Attach="[Event Click] = [Action ChangeUseMes]"
                        Content="{Binding UseMesButtonStr}"
                        FontSize="16" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recheck Rate" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <TextBlock Grid.Row="1" Text="{Binding DayPieReckeckTB}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:PieChart
                                Grid.Row="2"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Hoverable="False"
                                Series="{Binding DayPieReckeckSeriesCollection}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="UPH Recheck By Hour" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding DayHistogramUPHSeriesCollection2}"
                                Visibility="{Binding ShowUPH, Converter={StaticResource BoolToVisibleHiddenConvert}}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="小时" Foreground="White" FontSize="18" Labels="{Binding Labels}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="产量(pcs)" Foreground="White" FontSize="18" LabelFormatter="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="20"
                                Foreground="White"
                                Series="{Binding DayHistogramTossingSeriesCollection2}"
                                Visibility="{Binding ShowTossing, Converter={StaticResource BoolToVisibleHiddenConvert}}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="小时" Foreground="White" FontSize="18" Labels="{Binding Labels}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="良率(%)" Foreground="White" FontSize="18" Labels="{Binding Formatter}" MinValue="0" MaxValue="100">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray" Step="20"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recheck By Day" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                Name="RecheckWeekChart"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding WeekReckeckNGHistogramSeriesCollection}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsWeekRecheck}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="复检NG(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recheck NG By Nozzle" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding NozzleHistogramReckeckSeriesCollection}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsNozzle}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="数量(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recheck NG Summary" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding ReckeckNGReasonHistogramSeriesCollection}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsReacheckReason}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="数量(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="4" BorderBrush="#0096FF" BorderThickness="2" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recheck By Cavity" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White" FontSize="18" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                FontFamily="黑体"
                                FontSize="24"
                                Foreground="White"
                                Series="{Binding CavityHistogramReckeckSeriesCollection}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Foreground="White" FontSize="18" Labels="{Binding LabelsCavity}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="数量(pcs)" Foreground="White" FontSize="18" Labels="{Binding Formatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>