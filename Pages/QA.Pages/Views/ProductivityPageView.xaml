<UserControl
    x:Class="QA.Pages.Views.ProductivityPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:QA.Pages.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:QA.UserControls;assembly=QA.UserControls"
    Margin="5"
    d:DesignHeight="960"
    d:DesignWidth="1280"
    FontFamily="微软雅黑"
    FontSize="18"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86" />
            <Thickness x:Key="Padding1">3</Thickness>
            <convert:PcsConvert x:Key="PcsConvert" />
            <convert:FloatToSecondConvert x:Key="FloatToSecondConvert" />
            <convert:FloatToPercentConvert x:Key="FloatToPercentConvert" />
            <convert:BoolToConnectStringConvert x:Key="BoolToConnectStringConvert" />
            <convert:BoolToBackgroundConvert x:Key="BoolToBackgroundConvert" />

            <convert:TriStateToConnectStringConvert x:Key="TriStateToConnectStringConvert" />
            <convert:TriStateToBackgroundConvert x:Key="TriStateToBackgroundConvert" />

            <convert:BoolToEnableStringConvert x:Key="BoolToEnableStringConvert" />
            <convert:InfoLevelToColorConvert x:Key="InfoLevelToColorConvert" />
            <convert:BoolToVisibleHiddenConvert x:Key="BoolToVisibleHiddenConvert" />
            <Style x:Key="MoveFont" TargetType="TextBlock">
                <Setter Property="TextBlock.FontFamily" Value="微软雅黑" />
                <Setter Property="TextBlock.Width" Value="100" />
                <Setter Property="TextBlock.Height" Value="30" />
                <Setter Property="TextBlock.TextAlignment" Value="Center" />
                <Setter Property="TextBlock.Padding" Value="2" />
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                <Setter Property="TextBlock.FontSize" Value="18" />
                <Setter Property="TextBlock.Foreground" Value="Black" />
                <Style.Triggers>
                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#008D86" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl>
        <TabItem
            Width="200"
            FontSize="18"
            Header="{DynamicResource 图表}">
            <Grid Background="#FFDEDEDE">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <GroupBox Margin="5" Header="{DynamicResource 一天产量}" />
                <Grid Grid.Row="1" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{DynamicResource 选择日期}" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ChoicetData}" />
                            <!--<Button Grid.Column="2" Content="打开数据文件夹" FontSize="18" Height="40" Width="160"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    cal:Message.Attach="[Event Click] = [Action OpenFolder]"/>-->
                        </Grid>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            LegendLocation="Top"
                            Series="{Binding ToDayHistogramSeriesCollection}">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="小时" Labels="{Binding Labels}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="产量(Pcs)" LabelFormatter="{Binding Formatter}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator IsEnabled="False" Stroke="LightGray"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                        <lvc:PieChart
                            Grid.Row="1"
                            Grid.Column="1"
                            Hoverable="False"
                            LegendLocation="Bottom"
                            Series="{Binding ToDayPieSeriesCollection}" />
                    </Grid>
                </Grid>
                <GroupBox
                    Grid.Row="2"
                    Margin="5"
                    Header="{DynamicResource 一段时间内产量}" />
                <Grid Grid.Row="3" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{DynamicResource 起始日期}" />
                            <DatePicker
                                Grid.Row="0"
                                Grid.Column="1"
                                SelectedDate="{Binding StartData}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{DynamicResource 结束日期}" />
                            <DatePicker
                                Grid.Row="1"
                                Grid.Column="1"
                                SelectedDate="{Binding EndData}" />
                        </Grid>
                        <lvc:CartesianChart
                            Grid.Row="3"
                            LegendLocation="Top"
                            Series="{Binding ChoiceTimeSlotHistogramSeriesCollection}">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="天" Labels="{Binding ChoiceTimeSlotLabels}" />
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="产量(Pcs)" LabelFormatter="{Binding Formatter}" />
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                        <lvc:PieChart
                            Grid.Row="1"
                            Grid.Column="1"
                            Hoverable="False"
                            LegendLocation="Bottom"
                            Series="{Binding ChoiceTimeSlotPieSeriesCollection}" />
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem
            Width="200"
            FontSize="18"
            Header="{DynamicResource 数据}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox
                        Grid.Column="0"
                        FontFamily="微软雅黑"
                        Header="{DynamicResource 生产信息}"
                        Style="{StaticResource GroupBoxStyle1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="6*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 当前产量}"
                                    FontSize="18" />
                                <Label
                                    Grid.Column="1"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.CurrentNum}"
                                    FontSize="18" />
                                <Button
                                    Grid.Column="2"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    cal:Message.Attach="[Event Click] = [Action ResetCurrentNum]"
                                    Content="{DynamicResource 重置}"
                                    FontSize="18"
                                    IsEnabled="{Binding EnableButtons}" />
                                <Label
                                    Grid.Column="4"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 目标产量}"
                                    FontSize="18" />
                                <Label
                                    Grid.Column="5"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.TargetNum}"
                                    FontSize="18" />
                                <Label
                                    Grid.Column="7"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="CT"
                                    FontSize="18" />
                                <Label
                                    Grid.Column="8"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding CT.CycleCT, Converter={StaticResource FloatToSecondConvert}}"
                                    FontSize="18" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 产品总数}"
                                    FontSize="18" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.ProductCount}"
                                    FontSize="18" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 复检OK}"
                                    FontSize="18" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.OkCount}"
                                    FontSize="18" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 复检NG}"
                                    FontSize="18" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.NgCount}"
                                    FontSize="18" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{DynamicResource 良率}"
                                    FontSize="18" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding Statistic.OkRate, Converter={StaticResource FloatToPercentConvert}}"
                                    FontSize="18" />

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Height="Auto"
                                    Padding="{StaticResource Padding1}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    cal:Message.Attach="[Event Click] = [Action ResetCount()]"
                                    Content="{DynamicResource 清零}"
                                    FontSize="18"
                                    IsEnabled="{Binding EnableButtons}" />
                            </Grid>
                        </Grid>
                    </GroupBox>
                    <GridSplitter
                        Grid.Column="1"
                        Width="4"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource QuickGreen}" />
                    <GroupBox
                        Grid.Column="2"
                        FontFamily="微软雅黑"
                        Header="{DynamicResource 模块信息}"
                        Style="{StaticResource GroupBoxStyle1}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="PLC"
                                FontSize="18" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{Binding ConnectState.IsPlcConnected, Converter={StaticResource TriStateToBackgroundConvert}}"
                                Content="{Binding ConnectState.IsPlcConnected, Converter={StaticResource TriStateToConnectStringConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{DynamicResource 扫码枪}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{Binding ConnectState.IsScannerConnected, Converter={StaticResource TriStateToBackgroundConvert}}"
                                Content="{Binding ConnectState.IsScannerConnected, Converter={StaticResource TriStateToConnectStringConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{DynamicResource 视觉}"
                                FontSize="18" />
                            <Label
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{Binding ConnectState.IsVisionConnected, Converter={StaticResource TriStateToBackgroundConvert}}"
                                Content="{Binding ConnectState.IsVisionConnected, Converter={StaticResource TriStateToConnectStringConvert}}"
                                FontSize="18" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <Grid Grid.Row="2">
                    <GroupBox
                        FontFamily="微软雅黑"
                        Header="UPH"
                        Style="{StaticResource GroupBoxStyle1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="时间"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="计数"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="时间"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="计数"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="8:00-9:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph0, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="20:00-21:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="1"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph12, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="9:00-10:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph1, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="2"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="21:00-22:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="2"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph13, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="3"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="10:00-11:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="3"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph2, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="3"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="22:00-23:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="3"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph14, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="4"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="11:00-12:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="4"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph3, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="4"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="23:00-0:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="4"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph15, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="5"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="12:00-13:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="5"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph4, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="5"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="0:00-1:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="5"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph16, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="6"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="13:00-14:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="6"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph5, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="6"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="1:00-2:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="6"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Statistic.Uph17, Converter={StaticResource PcsConvert}}"
                                FontSize="18" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="7"
                                Padding="{StaticResource Padding1}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="14:00-15:00"
                                FontSize="18" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="7"
                                Padding="{StaticResource Padding1}"
