<UserControl x:Class="QA.Pages.Views.SetupPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.Views"
             mc:Ignorable="d" 
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             xmlns:uc="clr-namespace:QA.UserControls;assembly=QA.UserControls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             d:DesignHeight="970" d:DesignWidth="1600" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/DataGridStyle.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/DataGridStyle.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <convert:InfoLevelToColorConvert x:Key="InfoLevelToColorConvert"/>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86"></SolidColorBrush>
            <Style x:Key="CheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Setter Property="TextElement.FontFamily" Value="pack://application:,,,/Resources/#FontAwesome"/>
                <Setter Property="FontSize" Value="18"></Setter>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#008d8c"/>
                <Setter Property="Margin" Value="0,5,0,5"/>
            </Style>
            <Style x:Key="TextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="TextElement.FontFamily" Value="pack://application:,,,/Resources/#FontAwesome" />
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="Foreground" Value="#008d8c"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="LightBlue"></Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Margin" Value="0,2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="true">
                        <Setter Property="Foreground" Value="#008D86" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type GridViewColumnHeader}" x:Key="myHeaderStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl Margin="5">
        <TabItem Header="{DynamicResource 点检}" FontSize="18" Width="200">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="317*"/>
                    <ColumnDefinition Width="207*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1047*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,-0.4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="{DynamicResource 点检日志}" Grid.Row="0" Grid.Column="0" FontSize="18">
                        <uc:ScrollingListBox x:Name="WorkRunLog" Style="{x:Null}" ItemsSource="{Binding RunTimeLogs.Logs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DispMsg}" FontSize="18" Foreground="{Binding RunLevel,Converter={StaticResource InfoLevelToColorConvert}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="清空运行日志" cal:Message.Attach="[Event Click]=[Action ClearLogs]"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </uc:ScrollingListBox>
                    </GroupBox>
                </Grid>
                <GridSplitter Grid.Column="2" Width="4" Margin="5,0,4.6,-0.4" Background="{StaticResource QuickGreen}" 
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                <Grid Grid.Column="3" Margin="0.4,0,-0.2,-0.4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="2" Grid.Column="0" Header="{DynamicResource 点检项目}" FontSize="18">
                        <TabControl>
                            <TabItem Header="{DynamicResource MES设置}" Width="130" Height="35" FontSize="18">
                                <hc:ScrollViewer>
                                    <ContentControl x:Name="SpotCheckMesPageViewModel"/>
                                </hc:ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource 扫码点检}" Width="180" Height="35" FontSize="18">
                                <hc:ScrollViewer>
                                    <ContentControl x:Name="SpotCheckScannerPageViewModel"/>
                                </hc:ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource PLC点检}" Width="180" Height="35" FontSize="18">
                                <hc:ScrollViewer>
                                    <ContentControl x:Name="SpotCheckPlcPageViewModel"/>
                                </hc:ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource 相机点检}" Width="180" Height="35" FontSize="18">
                                <hc:ScrollViewer>
                                    <ContentControl x:Name="SpotCheckCameraPageViewModel"/>
                                </hc:ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource 图片上传}" Width="180" Height="35" FontSize="18">
                                <hc:ScrollViewer>
                                    <ContentControl x:Name="SpotCheckFTPUploadImgViewModel"/>
                                </hc:ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource 制程}" FontSize="18" Width="200">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <!-- 左侧区域 -->
                <Grid Grid.Column="0" Margin="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 制程操作1 -->
                            <RowDefinition Height="*"/>
                            <!-- 间距 -->
                            <RowDefinition Height="5"/>
                            <!-- 制程操作2 -->
                            <RowDefinition Height="*"/>
                            <!-- 间距 -->
                            <RowDefinition Height="5"/>
                            <!-- 制程名称 -->
                            <RowDefinition Height="*"/>
                            <!-- 分隔条 -->
                            <RowDefinition Height="Auto"/>
                            <!-- log -->
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>
                        <!-- 制程操作1 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{DynamicResource 加载制程}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="0"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action LoadProcedure]"/>
                            <Button Content="{DynamicResource 新建制程}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="2"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action NewProcedure]"/>
                            <Button Content="{DynamicResource 复制制程}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="4"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action CopyProcedure]"/>
                        </Grid>
                        <!-- 制程操作2 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{DynamicResource 删除制程}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="0"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action DeleteProcedure]"/>
                            <Button Content="{DynamicResource 保存制程}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="2"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SaveProcedure]"/>
                            <Button Content="{DynamicResource 打开示教}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="4"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action OpenTeachPanel]"/>
                        </Grid>
                        <!--制程名称-->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource 制程名称}" FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="0"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                            <TextBox Text="{Binding CurrProcedure.ProcedureName, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="微软雅黑" FontSize="20" Height="Auto" Grid.Column="2"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <!--分隔条-->
                        <Line Grid.Row="5" Stretch="Fill" Stroke="Gray" X2="1" Height="12"/>
                        <!--log-->
                        <uc:ScrollingListBox Grid.Row="6" Style="{x:Null}" ItemsSource="{Binding RunTimeLogs.Logs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DispMsg}" FontSize="18" Foreground="{Binding RunLevel,Converter={StaticResource InfoLevelToColorConvert}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="清空运行日志" cal:Message.Attach="[Event Click]=[Action ClearLogs]"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </uc:ScrollingListBox>
                    </Grid>
                </Grid>

                <!-- 分隔条 -->
                <GridSplitter Grid.Column="1" Width="4" Margin="0,8" Background="LightGray" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- 右侧区域 -->
                <Grid Grid.Column="2" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="100"/>
                        <!--<RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="100"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="200"/>-->
                    </Grid.RowDefinitions>
                    <!-- 拍照位置 -->
                    <GroupBox Grid.Row="0" Header="{DynamicResource 拍照位置}">
                        <DataGrid Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="false" CanUserSortColumns="False" 
                                      ItemsSource="{Binding CurrProcedure.VisionPoints}" SelectedItem="{Binding SelectedVisionPoint, Mode=TwoWay}"
                                      CellStyle="{StaticResource myDataGridCellStyle}"
                                      RowStyle="{StaticResource myDataGridRowStyle}"
                                      ColumnHeaderStyle="{StaticResource myDataGridColumnHeader}"
                                      Style="{StaticResource myDataGridStyle}"
                                      CanUserReorderColumns="False" 
                                      CanUserResizeRows="False" 
                                      AlternationCount="2" ColumnWidth="*">
                            <DataGrid.Columns >

                                <DataGridCheckBoxColumn Header="{DynamicResource 启用}" Binding="{Binding IsUsed,UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource 穴位号}" Binding="{Binding CavityNum,UpdateSourceTrigger=PropertyChanged}"/>
                                <!--<DataGridTextColumn Header="X" Binding="{Binding VisionPointX,UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding VisionPointY,UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource X贴合补偿}" Binding="{Binding VisionPointXOffset,UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Y贴合补偿}" Binding="{Binding VisionPointYOffset,UpdateSourceTrigger=PropertyChanged}"/>-->
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{x:Null}">
                                    <MenuItem Header="{DynamicResource 添加}" cal:Message.Attach="[Event Click]=[Action AddVisionPoint]"/>
                                    <MenuItem Header="{DynamicResource 删除}" cal:Message.Attach="[Event Click]=[Action DeleteVisionPoint]"/>
                                    <MenuItem Header="{DynamicResource 上移}" cal:Message.Attach="[Event Click]=[Action MoveUpVisionPoint]"/>
                                    <MenuItem Header="{DynamicResource 下移}" cal:Message.Attach="[Event Click]=[Action MoveDownVisionPoint]"/>
                                    <MenuItem Header="{DynamicResource 阵列}" cal:Message.Attach="[Event Click]=[Action ArrayVisionPoints]"/>
                                    <Separator />
                                    <MenuItem Header="{DynamicResource XY设置为当前坐标}" cal:Message.Attach="[Event Click]=[Action GetCurCrdVisionMenuClick()]"/>
                                    <MenuItem Header="{DynamicResource 移动到点位坐标}" cal:Message.Attach="[Event Click]=[Action MoveSelectPointVisionMenuClick()]"/>
                                    <Separator />
                                    <MenuItem Header="{DynamicResource 当前位置视觉定位Mark}" cal:Message.Attach="[Event Click]=[Action LocateMarkVisionMenuClick()]"/>
                                    <MenuItem Header="{DynamicResource 当前位置视觉获取二维码}" cal:Message.Attach="[Event Click]=[Action GetBarcodeFormVisionMenuClick()]"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
