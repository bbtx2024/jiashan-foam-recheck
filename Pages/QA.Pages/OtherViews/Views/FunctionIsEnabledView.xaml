<UserControl x:Class="QA.Pages.OtherViews.Views.FunctionIsEnabledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86"></SolidColorBrush>
            <Thickness x:Key="Padding1">3</Thickness>

            <convert:PcsConvert x:Key="PcsConvert"></convert:PcsConvert>
            <convert:FloatToSecondConvert x:Key="FloatToSecondConvert"></convert:FloatToSecondConvert>
            <convert:FloatToPercentConvert x:Key="FloatToPercentConvert"></convert:FloatToPercentConvert>
            <convert:BoolToConnectStringConvert x:Key="BoolToConnectStringConvert"></convert:BoolToConnectStringConvert>
            <convert:BoolToBackgroundConvert x:Key="BoolToBackgroundConvert"></convert:BoolToBackgroundConvert>
            <convert:BoolToEnableStringConvert x:Key="BoolToEnableStringConvert"></convert:BoolToEnableStringConvert>

            <Style x:Key="MoveFont" TargetType="TextBlock">
                <Setter Property="TextBlock.FontFamily" Value="微软雅黑" />
                <Setter Property="TextBlock.Width" Value="100"/>
                <Setter Property="TextBlock.Height" Value="30"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="TextBlock.Padding" Value="2"/>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
                <Setter Property="TextBlock.Foreground" Value= "Black"/>
                <Style.Triggers>
                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#008D86"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <ScrollViewer>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="5"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                </Grid.RowDefinitions>
                
                <Label Grid.Row="0" Grid.Column="0" Content="MES" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="0" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseMes, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseMes, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseMes]"/>

                <Label Grid.Row="2" Grid.Column="0" Content="提前取料" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="2" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.PrepareInAdvance, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.PrepareInAdvance, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchPrepareInAdvance]"/>

                <Label Grid.Row="4" Grid.Column="0" Content="1号吸嘴" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="4" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseNozzle1, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseNozzle1, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle1]"/>

                <Label Grid.Row="6" Grid.Column="0" Content="2号吸嘴" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="6" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseNozzle2, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseNozzle2, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle2]"/>

                <Label Grid.Row="8" Grid.Column="0" Content="3号吸嘴" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="8" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseNozzle3, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseNozzle3, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle3]"/>

                <Label Grid.Row="10" Grid.Column="0" Content="4号吸嘴" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="10" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseNozzle4, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseNozzle4, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle4]"/>

                <Label Grid.Row="12" Grid.Column="0" Content="检测真空吸" FontFamily="微软雅黑" FontSize="18" Height="auto"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Grid.Row="12" Grid.Column="2" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        Content="{Binding Enable.UseVacSucCheck, Converter={StaticResource BoolToEnableStringConvert}}"
                        Background="{Binding Enable.UseVacSucCheck, Converter={StaticResource BoolToBackgroundConvert}}" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action SwitchUseVacSucCheck]"/>
                
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
