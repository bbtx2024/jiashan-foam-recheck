<UserControl x:Class="QA.Pages.OtherViews.Views.NormalToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="MoveFont" TargetType="TextBlock">
                <Setter Property="TextBlock.FontFamily" Value="微软雅黑" />
                <Setter Property="TextBlock.Width" Value="150"/>
                <Setter Property="TextBlock.Height" Value="30"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="TextBlock.Padding" Value="2"/>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="14"/>
                <Setter Property="TextBlock.Foreground" Value= "Black"/>

                <Style.Triggers>
                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#008D86"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86"></SolidColorBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <ScrollViewer>
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="清除所有吸嘴吸取的物料" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action ClearTapes]"/>
                <Button Grid.Row="2" Content="生成自动补偿制程" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" cal:Message.Attach="[Event Click] = [Action CreateNewTask]"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
