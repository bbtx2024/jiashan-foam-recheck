<UserControl x:Class="QA.Pages.OtherViews.Views.NGStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             mc:Ignorable="d" 
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <convert:TrayStatusToColorConvert x:Key="TrayStatusToColorConvert"/>
        <convert:BoolToSelectedBackgroundConvert x:Key="BoolToSelectedBackgroundConvert"/>
    </UserControl.Resources>
    <Grid Margin="5" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock   Text="{Binding CarrierSn}" FontSize="30" TextWrapping="WrapWithOverflow"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Grid Grid.Row="1" Margin="5" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" x:Name="listbox" Style="{x:Null}" ItemsSource="{Binding SelectedTrayInfos}" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding CarrCols}" Rows="{Binding CarrRows}" 
                                 Width="{Binding Path=Width,RelativeSource={ RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}, AncestorLevel=1 }}"
                                 Height="{Binding Path=Height,RelativeSource={ RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}, AncestorLevel=1 }}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="{Binding Status, Converter={StaticResource TrayStatusToColorConvert}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding CavStr}" FontSize="18"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding CavStateInfo}" FontSize="18" TextWrapping="WrapWithOverflow"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding Str1}" FontSize="18" TextWrapping="WrapWithOverflow"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding Str2}" FontSize="18" TextWrapping="WrapWithOverflow"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="{DynamicResource 六层}" Background="{Binding IsLayerSelected[6], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('6')]" />
                <Button Grid.Row="1" Content="{DynamicResource 五层}" Background="{Binding IsLayerSelected[5], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('5')]" />
                <Button Grid.Row="2" Content="{DynamicResource 四层}" Background="{Binding IsLayerSelected[4], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('4')]" />
                <Button Grid.Row="3" Content="{DynamicResource 三层}" Background="{Binding IsLayerSelected[3], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('3')]" />
                <Button Grid.Row="4" Content="{DynamicResource 二层}" Background="{Binding IsLayerSelected[2], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('2')]" />
                <Button Grid.Row="5" Content="{DynamicResource 一层}" Background="{Binding IsLayerSelected[1], Converter={StaticResource BoolToSelectedBackgroundConvert}}"
                    Width="auto" Height="auto" FontSize="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click]=[Action SelectLayer('1')]" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
