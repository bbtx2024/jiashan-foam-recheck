<UserControl x:Class="QA.UserControls.Views.RobotTeachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.UserControls.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.UserControls.Converters"
             Width="500" Height="350" FontFamily="微软雅黑">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.UserControls;component/Styles/MoveFontStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            
            <convert:StationToBackgroundConvert x:Key="StationToBackgroundConvert"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <CheckBox Content="点动(mm)" Height="30" Margin="0,0,10,0" FontSize="18" IsChecked="{Binding IsDotMove}"/>
            <hc:NumericUpDown DecimalPlaces="2" Increment="0.01" Width="120" Margin="0,0,10,0" Value="{Binding DotStepLenth}" Minimum="0" Maximum="30"
                                  HorizontalContentAlignment="Center" FontSize="18" Padding="0"/>
            <Label Content="速度：" Background="Transparent" BorderThickness="0" FontSize="18" Margin="50,0,0,0"/>
            <ComboBox Width="120" ItemsSource="{Binding SpeedTypes}" SelectedIndex="{Binding SpeedTypeSelectIndex}" SelectedItem="{Binding CurSpeedType}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbForward" Grid.Row="0" Grid.Column="1" Text="&#xF062;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Forward','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Forward','false')]"/>

            <TextBlock x:Name="tbBackward" Grid.Row="1" Grid.Column="1" Text="&#xF063;" Style="{StaticResource MoveFont}" Padding="20,25"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Backward','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Backward','false')]"/>

            <TextBlock x:Name="tbLeft" Grid.Row="1" Grid.Column="0" Text="&#xF060;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Left','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Left','false')]"/>

            <TextBlock x:Name="tbRight" Grid.Row="1" Grid.Column="2" Text="&#xF061;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Right','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Right','false')]"/>

            <TextBlock x:Name="tbUp" Grid.Row="0" Grid.Column="3" Text="&#xF0aa;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Up','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Up','false')]"/>

            <TextBlock x:Name="tbDown" Grid.Row="1" Grid.Column="3" Text="&#xF0ab;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Down','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Down','false')]"/>

            <!--<TextBlock x:Name="tbRleft" Grid.Row="0" Grid.Column="2" Text="&#xF0e2;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Rleft','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Rleft','false')]"/>-->

            <!--<TextBlock x:Name="tbRright" Grid.Row="2" Grid.Column="2" Text="&#xF01e;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonDown] = [Action RobotMove('Rright','true')];
                       [Event MouseLeftButtonUp] = [Action RobotMove('Rright','false')]"/>-->

            <TextBlock x:Name="tbReset" Grid.Row="0" Grid.Column="4" Text="&#xF079;" Style="{StaticResource MoveFont}"
                       cal:Message.Attach="[Event MouseLeftButtonUp] = [Action RobotReset]"/>

            <Grid Grid.Row="1" Grid.Column="4" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{Binding CurStation, Converter={StaticResource StationToBackgroundConvert}, ConverterParameter=0}"
                        cal:Message.Attach="[Event Click] = [Action SwitchStation('0')]"/>
                <Button Content="1" Grid.Row="1" Grid.Column="0" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{Binding CurStation, Converter={StaticResource StationToBackgroundConvert}, ConverterParameter=1}"
                        cal:Message.Attach="[Event Click] = [Action SwitchStation('1')]"/>
                <Button Content="2" Grid.Row="1" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{Binding CurStation, Converter={StaticResource StationToBackgroundConvert}, ConverterParameter=2}" 
                        cal:Message.Attach="[Event Click] = [Action SwitchStation('2')]"/>
                <Button Content="3" Grid.Row="2" Grid.Column="0" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{Binding CurStation, Converter={StaticResource StationToBackgroundConvert}, ConverterParameter=3}" 
                        cal:Message.Attach="[Event Click] = [Action SwitchStation('3')]"/>
                <Button Content="4" Grid.Row="2" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{Binding CurStation, Converter={StaticResource StationToBackgroundConvert}, ConverterParameter=4}" 
                        cal:Message.Attach="[Event Click] = [Action SwitchStation('4')]"/>
            </Grid>

            <!--<TextBlock x:Name="tbStop" Grid.Row="2" Grid.Column="0" Text="&#xf04d;" Style="{StaticResource MoveFont}" FontSize="40" Padding="15,30"
                       cal:Message.Attach="[Event MouseLeftButtonUp] = [Action RobotStop]"/>-->

            <UniformGrid Rows="3" Grid.Row="2" Grid.Column="0" Margin="10,10">
                <StackPanel Orientation="Horizontal">
                    <Label Content="X:" BorderThickness="0" Background="Transparent"/>
                    <Label Content="{Binding Position_X}" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Y:" BorderThickness="0" Background="Transparent"/>
                    <Label Content="{Binding Position_Y}" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Z:" BorderThickness="0" Background="Transparent"/>
                    <Label Content="{Binding Position_Z}" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Grid.Row="2" Grid.Column="4" Margin="6,10"
                       Text=" 工站0:小滑台 &#13;工站1:左边视觉 &#13;工站2:左边焊接 &#13;工站3:右边视觉 &#13;工站4:右边焊接"/>

        </Grid>
    </Grid>
</UserControl>
