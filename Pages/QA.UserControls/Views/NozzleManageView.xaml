<UserControl x:Class="QA.UserControls.Views.NozzleManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.UserControls.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             d:DesignHeight="450" d:DesignWidth="800" Height="500" Width="600" FontFamily="微软雅黑" FontSize="18">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <!--<ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"></ResourceDictionary>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,100,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--喷咀SN-->
            <Label Content="喷咀SN" Grid.Row="0" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            <TextBox Text="{Binding NozzleManageParam.NozzleSN}" Grid.Row="0" Grid.Column="1"/>
            <!--更换喷咀时间-->
            <Label Content="更换喷咀时间" Grid.Row="1" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            <TextBox Text="{Binding NozzleManageParam.NozzleChangeTime}" Grid.Row="1" Grid.Column="1"/>
            <!--锡球SN-->
            <Label Content="锡球SN" Grid.Row="2" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            <TextBox Text="{Binding NozzleManageParam.TinBallSN}" Grid.Row="2" Grid.Column="1"/>
            <!--锡球打开时间-->
            <Label Content="锡球打开时间" Grid.Row="3" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            <TextBox Text="{Binding NozzleManageParam.TinBallOpenTime}" Grid.Row="3" Grid.Column="1"/>
            <!--锡球更换时间-->
            <Label Content="锡球更换时间" Grid.Row="4" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            <TextBox Text="{Binding NozzleManageParam.TinBallChangeTime}" Grid.Row="4" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--允许使用寿命-->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Label Content="允许使用寿命" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" Margin="5,0,0,0" FontSize="18"
                                  HorizontalAlignment="Left" Width="200" Value="{Binding NozzleManageParam.NozzleLifetime}"/>
            </StackPanel>
            <!--当前使用总计数-->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <Label Content="当前使用总计数" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal">
                    <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" FontSize="18" HorizontalAlignment="Left" Width="200"
                                      Value="{Binding NozzleManageParam.NozzleCurrUseTotalCount}"/>
                    <Button Content="更换喷咀完成" Height="Auto" VerticalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
            <!--清洗间隔-->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Content="清洗间隔" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" Margin="5,0,0,0" FontSize="18" 
                                  HorizontalAlignment="Left" Width="200" Value="{Binding NozzleManageParam.NozzleCleanInterval}"/>
            </StackPanel>
            <!--当前使用次数-->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Label Content="当前使用次数" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal">
                    <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" FontSize="18" HorizontalAlignment="Left" Width="200"
                                      Value="{Binding NozzleManageParam.NozzleCurrUseCount}"/>
                    <Button Content="清空" Height="Auto" VerticalAlignment="Stretch" Width="90"/>
                </StackPanel>
            </StackPanel>
            <!--使用寿命警告阈值-->
            <StackPanel Grid.Row="2" Grid.Column="0">
                <Label Content="使用寿命警告阈值" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" Margin="5,0,0,0" FontSize="18" 
                                  HorizontalAlignment="Left" Width="200" Value="{Binding NozzleManageParam.NozzleLifetimeAlarmPercent}"/>
            </StackPanel>
            <!--已清洗次数-->
            <StackPanel Grid.Row="2" Grid.Column="1">
                <Label Content="已清洗次数" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal">
                    <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" FontSize="18" HorizontalAlignment="Left" Width="200"
                                      Value="{Binding NozzleManageParam.NozzleCleanCount}"/>
                    <Button Content="清洗完成" Height="Auto" VerticalAlignment="Stretch" Width="90"/>
                </StackPanel>
            </StackPanel>
            <!--清洗间隔警告阈值-->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,50,0">
                <Label Content="清洗间隔警告阈值" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"/>
                <hc:NumericUpDown FontFamily="微软雅黑" Style="{StaticResource NumericUpDownPlus}" Margin="5,0,0,0" FontSize="18" 
                                  HorizontalAlignment="Left" Width="200" Value="{Binding NozzleManageParam.NozzleCleanAlarmPercent}"/>
            </StackPanel>
            <UniformGrid Grid.Row="3" Grid.Column="1" Columns="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0">
                <Button Content="{DynamicResource 确定}" Width="100" Margin="0,0,2,0"
                        cal:Message.Attach="[Event Click] = [Action Confirm]"/>
                <Button Content="{DynamicResource 取消}" Width="100" Margin="2,0,0,0"
                        cal:Message.Attach="[Event Click] = [Action Cancel]"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
