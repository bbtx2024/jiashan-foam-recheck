<UserControl x:Class="QA.SpotCheckPages.Views.SpotCheckCameraPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.SpotCheckPages.Views"
             xmlns:cal ="http://www.caliburnproject.org"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    <Grid Background="White">
        <ScrollViewer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!--Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="次数：" FontSize="18" Height="35"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <hc:NumericUpDown Grid.Column="1" hc:TitleElement.Title ="次数：" DecimalPlaces="0" FontSize="18" Padding="0"
                                      HorizontalContentAlignment="Center" Minimum="1" Maximum="100"
                                      Value="{Binding TestCount,UpdateSourceTrigger =PropertyChanged}" 
                                      cal:Message.Attach="[Event ValueChanged] = [Action NumUDTestCountChanged($source)]"
                                      Height="35" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Label Grid.Column="2" Content="轴精度停顿时间(s)：" FontSize="18" Height="35"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <hc:NumericUpDown Grid.Column="3" hc:TitleElement.Title ="轴精度停顿时间：" DecimalPlaces="1" FontSize="18" Padding="0"
                                      HorizontalContentAlignment="Center" Minimum="0.1" Maximum="10"
                                      Value="{Binding AxisWaitTime,UpdateSourceTrigger =PropertyChanged}" 
                                      cal:Message.Attach="[Event ValueChanged] = [Action NumUDTestCavityChanged($source)]"
                                      Height="35" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Line Grid.Row="1" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetUpCamStaticTestPos" Content="设置上相机静态测试位置" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpCamStaticTestPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveUpCamStaticTestPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoUpCamStaticTest" Content="静态测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Line Grid.Row="3" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetDownCamStaticTestPos" Content="设置下相机静态测试位置" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DownCamStaticTestPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveDownCamStaticTestPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoDownCamStaticTest" Content="静态测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Line Grid.Row="5" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetUpCamDynamicTestStartPos" Content="设置上相机动态测试静点" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpCamDynamicTestStartPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveUpCamDynamicTestStartPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoUpCamDynamicTest" Content="动态测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetUpCamDynamicTestEndPos" Content="设置上相机动态测试动点" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpCamDynamicTestEndPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveUpCamDynamicTestEndPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoUpCamAxisTest" Content="轴精度测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Line Grid.Row="8" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetDownCamDynamicTestStartPos" Content="设置下相机动态测试静点" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DownCamDynamicTestStartPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveDownCamDynamicTestStartPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoDownCamDynamicTest" Content="动态测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="SetDownCamDynamicTestEndPos" Content="设置下相机动态测试动点" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DownCamDynamicTestEndPos}" FontSize="18" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="MoveDownCamDynamicTestEndPos" Content="空移" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Name="DoDownCamAxisTest" Content="轴精度测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <Line Grid.Row="11" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="StopTest" Content="停止测试" FontSize="18" Height="35" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Name="ReadData" Content="查看数据" FontSize="18" Height="35" HorizontalAlignment="Stretch"/>
                </Grid-->

                <Button Grid.Row="0" Name="DoUpCamStaticTest" Content="{DynamicResource 静态测试}" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Button Grid.Row="1" Name="DoUpCamDynamicTest" Content="{DynamicResource 动态测试}" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{DynamicResource 使用次数：}" FontSize="18" Height="35"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <hc:NumericUpDown Grid.Column="1" hc:TitleElement.Title ="{DynamicResource 使用次数：}" DecimalPlaces="0" FontSize="18" Padding="0"
                                      HorizontalContentAlignment="Center" Minimum="1" Maximum="100"
                                      Value="{Binding TestCount,UpdateSourceTrigger =PropertyChanged}" 
                                      cal:Message.Attach="[Event ValueChanged] = [Action NumUDTestCountChanged($source)]"
                                      Height="35" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <!--Button Grid.Row="2" Name="DoUpCamAxisTest" Content="轴精度测试" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"/-->
                <Line Grid.Row="3" Stroke="Gray" X2="2" Stretch="Fill" Margin="2,5,2,5"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="StopTest" Content="{DynamicResource 停止测试}" FontSize="18" Height="35" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Name="ReadData" Content="{DynamicResource 查看数据}" FontSize="18" Height="35" HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBox
                        Grid.Row="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="18"
                        Foreground="Black"
                        IsEnabled="{Binding Change1}"
                        Text="{Binding SendStr}" />
                <Button  Grid.Row="6" Name="SendCameraTest" Content="{DynamicResource 发送测试}" FontSize="18" Height="35"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
