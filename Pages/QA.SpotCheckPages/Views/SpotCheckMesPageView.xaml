<UserControl
    x:Class="QA.SpotCheckPages.Views.SpotCheckMesPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converts="clr-namespace:QA.Business.Converts;assembly=QA.Business"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:QA.SpotCheckPages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="5"
            FontSize="18"
            Header="{DynamicResource MES设置}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="LineName：" />
                    <TextBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="18"
                        Foreground="Black"
                        IsEnabled="{Binding Change1}"
                        Text="{Binding LineName}" />
                </Grid>
                <Grid
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="207*" />
                        <ColumnDefinition Width="120*"/>
                        <ColumnDefinition Width="655*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="StationName：" Grid.ColumnSpan="2" />
                    <TextBox
                        Grid.Column="1"
                        FontSize="18"
                        Foreground="Black"
                        IsEnabled="False"
                        Text="{Binding StationName}" Grid.ColumnSpan="2" Margin="120,0,0,0" />
                </Grid>
                <Grid
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="Fixid：" />
                    <TextBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="18"
                        Foreground="Black"
                        IsEnabled="{Binding Change1}"
                        Text="{Binding Fixid}" />
                </Grid>
                <Button
                    Name="AllowModifyLeft"
                    Grid.Row="3"
                    Height="auto"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{DynamicResource 允许修改参数}"
                    FontSize="18"
                    IsEnabled="{Binding Allow1}" />
                <Button
                    Name="SaveLeftParam"
                    Grid.Row="4"
                    Height="auto"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{DynamicResource 保存参数}"
                    FontSize="18"
                    IsEnabled="{Binding Save1}" />
            </Grid>
        </GroupBox>
        <!--20250718-->
        <GroupBox
            Grid.Row="1"
            Margin="5"
            FontSize="18"
            Header="解锁设置">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Black"
                Text="软件Hash值：" />
                    <TextBox Width="400" Margin="5" Text="{Binding SoftWareHashValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Black"
                Text="视觉Hash值：" />
                    <TextBox Width="400" Margin="5" Text="{Binding VisualHashValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Black"
                Text="参数Hash值：" />
                    <TextBox Width="400" Margin="5" Text="{Binding ParameterHashValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Black"
                Text="ICT AME ID：" />
                    <TextBox Width="400" Margin="5" Text="{Binding AdministratorID}"/>

                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <Button Content="unlock" Width="500" Margin="5" Name="unlock"
                            Command="{Binding unlock}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <Button Content="测试用" Width="500" Margin="5" Name="TestUsing"
                            HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </GroupBox>


    </Grid>
</UserControl>
