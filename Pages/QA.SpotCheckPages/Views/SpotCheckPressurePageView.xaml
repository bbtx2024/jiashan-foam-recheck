<UserControl x:Class="QA.SpotCheckPages.Views.SpotCheckPressurePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.SpotCheckPages.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal ="http://www.caliburnproject.org"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <ScrollViewer>
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="机头选择：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <ComboBox ItemsSource="{Binding Model.Heads}" SelectedIndex="{Binding Model.SltHeadIdx}"
                              HorizontalContentAlignment="Center"
                              cal:Message.Attach="[Event SelectionChanged] = [Action  GetCurPress($source)]">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Head}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label Content="当前压力：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <Label Content="{Binding Model.CurPress}" FontSize="18"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </UniformGrid>

                <Line Stroke="Gray" X2="1" Stretch="Fill" Margin="2,2,2,2"/>

                <UniformGrid Columns="2">
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" Padding="0" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.LowPressCalibValue}"/>
                    <Button Content="低压校准" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                            cal:Message.Attach="[Event Click] = [Action DoLowPressCalib]"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" Padding="0" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.HighPressCalibValue}"/>
                    <Button Content="高压校准" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                            cal:Message.Attach="[Event Click] = [Action DoHighPressCalib]"/>
                </UniformGrid>

                <Line Stroke="Gray" X2="1" Stretch="Fill" Margin="2,2,2,2"/>

                <UniformGrid Columns="2">
                    <Button x:Name="SetPressPos" Content="设置动压力点位" Height="Auto"  FontSize="18" HorizontalAlignment="Stretch"></Button>
                    <TextBlock Text="{Binding CurPressPosVlaue}"  VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Stretch"></TextBlock>
                    <Button x:Name="MoveSpacePressPosXY" Content="空移XY"  Height="Auto" FontSize="18" HorizontalAlignment="Stretch"></Button>
                    <Button x:Name="MoveSpacePressPosZ"  Content="空移Z" Height="Auto" FontSize="18" HorizontalAlignment="Stretch"></Button>
                </UniformGrid>
                <Line Stroke="Gray" X2="1" Stretch="Fill" Margin="2,2,2,2"/>
                <UniformGrid Columns="2">
                    <Label Content="空压目标位置(mm)：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.DoPressTargetPos}"/>
                    <Label Content="空压目标压力(N)：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.DoPressTargetPress}"/>
                    <Label Content="空压速度(mm/s)：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.DoPressSpeed}"/>
                    <Label Content="超时时间(ms)：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.DoPressTimeout}"/>
                    <Label Content="上抬距离(mm)：" FontSize="18" HorizontalAlignment="Stretch"/>
                    <hc:NumericUpDown DecimalPlaces="2" FontSize="18" HorizontalContentAlignment="Center"
                                      Value="{Binding Model.DoPressLiftUp}"/>
                </UniformGrid>

                <UniformGrid Columns="1">
                    <Button Content="执行一次空压" Margin="5,5" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                            cal:Message.Attach="[Event Click] = [Action DoEmptyPress]"/>
                    <Button Content="停止空压" Margin="5,5" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                            cal:Message.Attach="[Event Click] = [Action StopEmptyPress]"/>
                    <Button Name="SaveEmptyPressParam" Margin="5,5" Content="保存压力参数" Height="Auto" FontSize="18" HorizontalAlignment="Stretch"
                            ></Button>
                    <Button Name="GetCurPress" Margin="5,5" Content="获取当前压力" Height="Auto" FontSize="18" HorizontalAlignment="Stretch"
                            ></Button>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

