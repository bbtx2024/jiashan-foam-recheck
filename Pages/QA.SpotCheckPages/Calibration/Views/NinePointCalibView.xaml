<UserControl x:Class="QA.SpotCheckPages.Calibration.Views.NinePointCalibView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:local="clr-namespace:QA.SpotCheckPages.Calibration.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <TabControl>
            <TabItem Header="1号相机标定"  Width="180" Height="30" FontSize="18" Padding="2">
                <hc:ScrollViewer>
                    <UniformGrid Columns="1" Rows="9" Margin="0,0,0,10">
                        
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_1" Content="设置上相机9点标定1号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(1)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_1" Content="空移上相机9点标定1号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(1)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_1, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>
                            <Button x:Name="CalibNinePointToUpCameraNo1" Content="执行上相机9点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action CalibNinePoint(1)]"/>
                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_2" Content="设置上相机9点标定2号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(2)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_2" Content="空移上相机9点标定2号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(2)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_2, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>
                           
                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_3" Content="设置上相机9点标定3号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(3)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_3" Content="空移上相机9点标定3号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(3)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_3, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_4" Content="设置上相机9点标定4号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(4)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_4" Content="空移上相机9点标定4号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(4)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_4, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_5" Content="设置上相机9点标定5号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(5)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_5" Content="空移上相机9点标定5号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(5)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_5, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_6" Content="设置上相机9点标定6号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(6)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_6" Content="空移上相机9点标定6号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(6)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_6, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_7" Content="设置上相机9点标定7号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(7)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_7" Content="空移上相机9点标定7号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(7)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_7, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>

                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_8" Content="设置上相机9点标定8号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(8)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_8" Content="空移上相机9点标定8号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(8)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_8, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo1_9" Content="设置上相机9点标定9号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(9)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo1_9" Content="空移上相机9点标定8号坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(9)]"></Button>
                            <TextBlock  Text="{Binding CurCamNo1NineCalibPos_9, Mode=TwoWay}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                        </UniformGrid>


                    </UniformGrid>
                </hc:ScrollViewer>
            </TabItem>
            <TabItem Header="2号相机标定"  Width="180" Height="30" FontSize="18" Padding="2">
                <hc:ScrollViewer>
                    <UniformGrid Columns="1" Rows="1" Margin="0,0,0,10">
                        <UniformGrid Columns="4" Rows="7">

                            <Button x:Name="SetCalibNinePointPosToDownCamera_NozzleNo1" Visibility="Hidden" Content="设置1号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(1)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToDownCamera_NozzleNo1" Visibility="Hidden"  Content="空移1号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(1)]"></Button>
                            <Button x:Name="CalibNinePointToDownCamera_NozzleNo1" Visibility="Hidden" Content="执行1号吸嘴下相机11点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(1)]"/>
                            <TextBlock  Text="{Binding CurCamNo2NozzleNo1Pos}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                            <Button x:Name="SetCalibNinePointPosToDownCamera_NozzleNo2" Content="设置2号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(2)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToDownCamera_NozzleNo2" Content="空移2号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(2)]"></Button>
                            <Button x:Name="CalibNinePointToDownCamera_NozzleNo2" Content="执行2号吸嘴下相机11点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(2)]"/>
                            <TextBlock  Text="{Binding CurCamNo2NozzleNo2Pos}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                            <Button x:Name="SetCalibNinePointPosToDownCamera_NozzleNo3" Content="设置3号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(3)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToDownCamera_NozzleNo3" Content="空移3号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(3)]"></Button>
                            <Button x:Name="CalibNinePointToDownCamera_NozzleNo3" Content="执行3号吸嘴下相机11点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(3)]"/>
                            <TextBlock  Text="{Binding CurCamNo2NozzleNo3Pos}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>

                            <Button x:Name="SetCalibNinePointPosToDownCamera_NozzleNo4"   Content="设置4号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(4)]"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToDownCamera_NozzleNo4"  Content="空移4号吸嘴下相机标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(4)]"></Button>
                            <Button x:Name="CalibNinePointToDownCamera_NozzleNo4"  Content="执行4号吸嘴下相机11点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                        cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(4)]"/>
                            <TextBlock  Text="{Binding CurCamNo2NozzleNo4Pos}" FontSize="18" Width="200" Height="35" Padding="0,10"></TextBlock>
                            
                            <Button x:Name="EndCalibration" Content="标定结束" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"/>
                            
                            <hc:NumericUpDown  HorizontalAlignment="Left"  hc:TitleElement.Title ="距离(mm)：" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource NumericUpDownPlus}" Width="180"
                                    IsEnabled="{Binding IsJogChecked}" Margin="10,17,0,16" hc:TitleElement.TitleWidth="80" HorizontalContentAlignment="Center" Value="{Binding CalibMoveDis,UpdateSourceTrigger =PropertyChanged}" 
                                    DecimalPlaces="1" Foreground="Black" FontSize="12" Height="30" 
                                      cal:Message.Attach="[Event ValueChanged] = [Action NumUDMoveDisChanged($source)]"         ></hc:NumericUpDown>
                        </UniformGrid>
                    </UniformGrid>
                </hc:ScrollViewer>
            </TabItem>
            <!--<TabItem Header="3号相机标定"  Width="180" Height="30" FontSize="18" Padding="2">-->
                <!--<hc:ScrollViewer>
                    <UniformGrid Columns="1" Rows="1" Margin="0,0,0,10">
                        <UniformGrid Columns="4" Rows="7">
                            <Button x:Name="SetCalibNinePointPosToUpCameraNo3" Content="设置上相机9点标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>
                            <Button x:Name="MoveSpaceCalibNinePointPosToUpCameraNo3" Content="空移上相机9点标定坐标" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>
                            <Button x:Name="CalibNinePointToUpCameraNo3" Content="执行上相机9点标定" Width="180" Height="35" Style="{DynamicResource ButtonPrimary}"
                                    cal:Message.Attach="[Event Click] = [Action CalibNinePoint(3)]"/>
                            <TextBlock  Text="123" FontSize="18" Width="150" Height="35" Padding="0,10"></TextBlock>

                            <hc:NumericUpDown  HorizontalAlignment="Left"  hc:TitleElement.Title ="距离(mm)：" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource NumericUpDownPlus}" Width="180"
