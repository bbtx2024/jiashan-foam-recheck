                                    DecimalPlaces="1" Foreground="Black" FontSize="12" Height="30"></hc:NumericUpDown>
                        </UniformGrid>
                    </UniformGrid>
                </hc:ScrollViewer>-->
            <!--</TabItem>-->

            <!--</TabItem>-->
        </TabControl>
    </Grid>
</UserControl>
