<UserControl x:Class="QA.SpotCheckPages.Calibration.Views.AutoCalibView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:local="clr-namespace:QA.SpotCheckPages.Calibration.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <UniformGrid Columns="1" Rows="4">
            <UniformGrid Columns="3" Rows="1">
                <Button x:Name="MoveSpacePosToFeederPickMaterial"  Content="xxxxx" Width="150" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>
                <Button x:Name="SetFeederPickMaterialPos" Content="xxxxx" Width="150" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>
                <TextBlock  Text="{Binding CurAxisFeederPickPos}" FontSize="18" Width="150" Height="35"></TextBlock>

            </UniformGrid>
            <UniformGrid Columns="4" Rows="1"/>

            <UniformGrid Columns="2" Rows="1">
                <hc:NumericUpDown  HorizontalAlignment="Left"  hc:TitleElement.Title ="设置熨烫时间(s):" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource NumericUpDownPlus}" Width="250"
                                IsEnabled="{Binding IsJogChecked}" Margin="10,10" hc:TitleElement.TitleWidth="120" HorizontalContentAlignment="Center" Value="{Binding SolderIronTime}" 
                                DecimalPlaces="2" Foreground="Black" FontSize="18" Height="40"
                                   cal:Message.Attach="[Event ValueChanged] = [Action NumUDSolderIronTimeChanged($source)]"></hc:NumericUpDown>
            </UniformGrid>
            <UniformGrid Columns="4" Rows="1">
                <hc:NumericUpDown  HorizontalAlignment="Left"  hc:TitleElement.Title ="X偏置(mm):" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource NumericUpDownPlus}" Width="180"
                                IsEnabled="{Binding IsJogChecked}" Margin="10,10" hc:TitleElement.TitleWidth="85" HorizontalContentAlignment="Center" Value="{Binding SolderIronBiasX}" 
                                DecimalPlaces="2" Foreground="Black" FontSize="18" Height="40"
                                   cal:Message.Attach="[Event ValueChanged] = [Action NumUDSolderIronBiasXValueChanged($source)]"></hc:NumericUpDown>
                
                <hc:NumericUpDown HorizontalAlignment="Left" hc:TitleElement.Title ="Y偏置(mm)：" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource NumericUpDownPlus}" Width="180"
                                IsEnabled="{Binding IsJogChecked}" Margin="10,10" hc:TitleElement.TitleWidth="85" HorizontalContentAlignment="Center" Value="{Binding SolderIronBiasY}" 
                                DecimalPlaces="2" Foreground="Black" FontSize="18" Height="40"
                                  cal:Message.Attach="[Event ValueChanged] = [Action NumUDSolderIronBiasYValueChanged($source)]"></hc:NumericUpDown>
                
                <Button  x:Name="SetOffsetDis" Content="确定" Width="120" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>
                <Button  x:Name="ExAutoCalibration" Content="一键自动标定" Width="150" Height="35" Style="{DynamicResource ButtonPrimary}"></Button>


            </UniformGrid>
        </UniformGrid>
    </Grid>
</UserControl>
